{
  "name": "pyforge-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write --loglevel=warn",
    "format:check": "prettier --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:run:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium --grep=smoke",
    "playwright:install": "playwright install",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@authjs/react": "1.0.67-alpha.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "eslint": "^8",
    "eslint-plugin-import": "^2",
    "eslint-plugin-react": "^7",
    "lucide-react": "^0.375.0",
    "monaco-editor": "^0.57.0",
    "next": "14.2.4",
    "next-auth": "^4.24.15",
    "postcss": "^8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stylistic": "^0.2.4",
    "tailwindcss": "^3.4.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42",
    "@testing-library/react": "^14",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^1",
    "eslint-config-next": "^14",
    "eslint-plugin-tailwindcss": "^3",
    "jsdom": "^31.0.1",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^7",
    "vitest": "^1"
  }
}